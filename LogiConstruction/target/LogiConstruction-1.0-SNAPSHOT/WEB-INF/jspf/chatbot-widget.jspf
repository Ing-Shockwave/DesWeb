<%@ page pageEncoding="UTF-8" %>
<%
    Object lcChatbotUsuarioObj = session.getAttribute("usuario");
    String lcChatbotRolCodigo = "";
    if (lcChatbotUsuarioObj instanceof com.utp.logiconstruction.modelo.Usuario) {
        lcChatbotRolCodigo = ((com.utp.logiconstruction.modelo.Usuario) lcChatbotUsuarioObj).getRol();
    }
%>
<!-- LogiBot: chatbot informativo interno de LogiConstruction -->
<div class="lc-chatbot"
     data-context-path="<%= request.getContextPath() %>"
     aria-live="polite"
     aria-hidden="true">

    <section class="lc-chatbot__panel"
             id="lc-chatbot-panel"
             role="dialog"
             aria-modal="false"
             aria-labelledby="lc-chatbot-title"
             hidden>

        <header class="lc-chatbot__header">
            <div class="lc-chatbot__identity">
                <span class="lc-chatbot__avatar" aria-hidden="true">
                    <i class="fa-solid fa-robot"></i>
                </span>
                <div>
                    <strong id="lc-chatbot-title">LogiBot</strong>
                    <small><span class="lc-chatbot__status-dot"></span> Asistente informativo</small>
                </div>
            </div>

            <button class="lc-chatbot__close"
                    type="button"
                    aria-label="Cerrar LogiBot"
                    title="Cerrar">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>

        <div class="lc-chatbot__messages" role="log" aria-label="Conversaci&#243;n con LogiBot">
            <div class="lc-chatbot__message lc-chatbot__message--bot">
                <span class="lc-chatbot__mini-avatar" aria-hidden="true">
                    <i class="fa-solid fa-robot"></i>
                </span>
                <div class="lc-chatbot__bubble">
                    Hola, soy LogiBot. Puedo orientarte seg&#250;n tu rol y consultar informaci&#243;n de compras,
                    proveedores y requerimientos. No modifico datos del sistema.
                </div>
            </div>
        </div>

        <div class="lc-chatbot__quick-actions" aria-label="Consultas r&#225;pidas">
            <% if ("ADMINISTRADOR_OBRA".equals(lcChatbotRolCodigo)) { %>
                <button type="button" data-chat-message="&#191;Cu&#225;ntos requerimientos pendientes hay?">Pendientes</button>
                <button type="button" data-chat-message="&#191;C&#243;mo registro un requerimiento?">Registrar requerimiento</button>
                <button type="button" data-chat-message="&#191;Cu&#225;l es mi rol?">Mi rol</button>
            <% } else if ("JEFE_LOGISTICA".equals(lcChatbotRolCodigo)) { %>
                <button type="button" data-chat-message="&#191;Cu&#225;ntos proveedores activos hay?">Proveedores activos</button>
                <button type="button" data-chat-message="&#218;ltimas compras">&#218;ltimas compras</button>
                <button type="button" data-chat-message="Requerimientos pendientes">Pendientes</button>
            <% } else if ("GERENCIA".equals(lcChatbotRolCodigo)) { %>
                <button type="button" data-chat-message="Resumen del sistema">Resumen</button>
                <button type="button" data-chat-message="Costo total de compras">Costo total</button>
                <button type="button" data-chat-message="Material m&#225;s comprado">Material destacado</button>
            <% } else { %>
                <button type="button" data-chat-message="&#191;Qu&#233; puedes hacer?">&#191;Qu&#233; puedes hacer?</button>
                <button type="button" data-chat-message="&#191;Cu&#225;l es mi rol?">Mi rol</button>
            <% } %>
        </div>

        <form class="lc-chatbot__form" autocomplete="off">
            <label class="sr-only" for="lc-chatbot-input">Escribe tu consulta</label>
            <input id="lc-chatbot-input"
                   name="mensaje"
                   type="text"
                   maxlength="400"
                   placeholder="Escribe una consulta..."
                   required />
            <button type="submit" aria-label="Enviar consulta" title="Enviar">
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            </button>
        </form>

        <div class="lc-chatbot__footer">
            Respuestas informativas basadas en reglas y datos del sistema.
        </div>
    </section>

    <button class="lc-chatbot__launcher"
            type="button"
            aria-controls="lc-chatbot-panel"
            aria-expanded="false"
            tabindex="-1"
            aria-label="Abrir LogiBot"
            title="Abrir asistente virtual">
        <i class="fa-solid fa-robot" aria-hidden="true"></i>
        <span class="lc-chatbot__launcher-label">LogiBot</span>
    </button>
</div>
<script src="<%= request.getContextPath() %>/js/chatbot.js?v=2" defer></script>
